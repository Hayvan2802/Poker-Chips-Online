{
  "rules": {
    "poker": {
      "v2": {
        "rooms": {
          "$roomId": {
            ".read": "auth != null && (!data.exists() || data.child('members').child(auth.uid).exists())",
            ".write": "auth != null && newData.exists() && ((!data.exists() && newData.child('hostUid').val() === auth.uid && newData.child('status').val() === 'lobby' && newData.child('version').val() === 1) || data.child('hostUid').val() === auth.uid)",
            ".validate": "$roomId.matches(/^[0-9]{6}$/) && newData.hasChildren(['code','name','hostUid','creationAction','status','version','createdAt','settings','members']) && newData.child('code').val() === $roomId && newData.child('hostUid').isString() && (!data.exists() || newData.child('hostUid').val() === data.child('hostUid').val() || (auth.uid === data.child('hostUid').val() && data.child('members').child(newData.child('hostUid').val()).exists() && (data.child('status').val() === 'lobby' || data.child('game/phase').val() === 'settled' || data.child('game/phase').val() === 'waiting-deal'))) && newData.child('members').child(newData.child('hostUid').val()).child('host').val() === true",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "status": {
              ".validate": "newData.val() === 'lobby' || newData.val() === 'playing'"
            },
            "version": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 === 0"
            },
            "settings": {
              ".validate": "newData.hasChildren(['stack','sb','bb']) && newData.child('stack').isNumber() && newData.child('sb').isNumber() && newData.child('bb').isNumber() && newData.child('stack').val() % 1 === 0 && newData.child('sb').val() % 1 === 0 && newData.child('bb').val() % 1 === 0 && newData.child('sb').val() > 0 && newData.child('bb').val() > newData.child('sb').val() && newData.child('bb').val() <= newData.child('stack').val() && newData.child('stack').val() <= 1000000000",
              "blindMinutes": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 180"
              },
              "blindMultiplier": {
                ".validate": "newData.val() === 1.5 || newData.val() === 2"
              },
              "ante": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= newData.parent().child('bb').val()"
              },
              "anteMode": {
                ".validate": "newData.val() === 'each' || newData.val() === 'bb'"
              },
              "buyInCents": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 1000000000"
              },
              "blindPlan": {
                ".validate": "newData.hasChildren()",
                "$step": {
                  ".validate": "$step.matches(/^(0|[1-9]|1[0-9]|2[0-3])$/) && newData.hasChildren(['kind','minutes']) && ((newData.child('kind').val() === 'level' && newData.hasChildren(['sb','bb']) && newData.child('sb').val() < newData.child('bb').val()) || (newData.child('kind').val() === 'break' && newData.child('minutes').val() <= 60))",
                  "kind": {
                    ".validate": "newData.val() === 'level' || newData.val() === 'break'"
                  },
                  "minutes": {
                    ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 180"
                  },
                  "sb": {
                    ".validate": "newData.parent().child('kind').val() === 'level' && newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 1000000000"
                  },
                  "bb": {
                    ".validate": "newData.parent().child('kind').val() === 'level' && newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 1000000000"
                  },
                  "ante": {
                    ".validate": "newData.parent().child('kind').val() === 'level' && newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 1000000000 && newData.val() <= newData.parent().child('bb').val()"
                  },
                  "anteMode": {
                    ".validate": "newData.parent().child('kind').val() === 'level' && (newData.val() === 'each' || newData.val() === 'bb')"
                  },
                  "$other": {
                    ".validate": false
                  }
                }
              },
              "denominations": {
                ".validate": "newData.hasChildren()",
                "$chip": {
                  ".validate": "$chip.matches(/^[0-9]$/) && newData.hasChildren(['color','value'])",
                  "color": {
                    ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
                  },
                  "value": {
                    ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 1000000000"
                  },
                  "$other": {
                    ".validate": false
                  }
                }
              }
            },
            "members": {
              "$uid": {
                ".validate": "newData.hasChildren(['uid','name','host','ready']) && newData.child('uid').val() === $uid && newData.child('name').isString() && newData.child('name').val().length >= 2 && newData.child('name').val().length <= 24 && newData.child('ready').isBoolean() && newData.child('host').val() === ($uid === newData.parent().parent().child('hostUid').val()) && (!newData.child('seat').exists() || (newData.child('seat').isNumber() && newData.child('seat').val() % 1 === 0 && newData.child('seat').val() >= 0 && newData.child('seat').val() <= 8)) && (!newData.child('timeBank').exists() || (newData.child('timeBank').isNumber() && newData.child('timeBank').val() >= 0 && newData.child('timeBank').val() <= 2 && newData.child('timeBank').val() % 1 === 0)) && (!newData.child('sittingOut').exists() || newData.child('sittingOut').isBoolean())"
              }
            },
            "presence": {
              "$uid": {
                "$connection": {
                  ".write": "auth != null && auth.uid === $uid && root.child('poker/v2/rooms').child($roomId).child('members').child(auth.uid).exists()",
                  ".validate": "newData.val() === true"
                }
              }
            },
            "blindClock": {
              ".validate": "newData.hasChildren(['level', 'nextIncreaseAt']) && newData.child('level').isNumber() && newData.child('level').val() >= 1 && newData.child('level').val() % 1 === 0 && newData.child('nextIncreaseAt').isNumber() && newData.child('nextIncreaseAt').val() >= 0 && (!newData.child('breakUntil').exists() || (newData.child('breakUntil').isNumber() && newData.child('breakUntil').val() > 0))"
            },
            "turnClock": {
              ".validate": "newData.hasChildren(['uid','deadline']) && newData.child('uid').isString() && newData.child('uid').val() === newData.parent().child('game/turn').val() && newData.child('deadline').isNumber() && newData.child('deadline').val() > 0"
            }
          }
        },
        "requests": {
          "$roomId": {
            ".read": "auth != null && root.child('poker/v2/rooms').child($roomId).child('hostUid').val() === auth.uid",
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              "$actionId": {
                ".write": "auth != null && ((auth.uid === $uid && ((!data.exists() && newData.exists() && root.child('poker/v2/rooms').child($roomId).exists()) || !newData.exists())) || (!newData.exists() && root.child('poker/v2/rooms').child($roomId).child('hostUid').val() === auth.uid))",
                ".validate": "$actionId.matches(/^[a-zA-Z0-9_-]{8,100}$/) && newData.hasChildren(['uid','actionId','kind','payload','createdAt']) && newData.child('uid').val() === $uid && newData.child('actionId').val() === $actionId && (newData.child('kind').val() === 'joinRoom' || (newData.child('kind').val() === 'roomCommand' && root.child('poker/v2/rooms').child($roomId).child('members').child($uid).exists())) && newData.child('createdAt').isNumber() && newData.child('createdAt').val() <= now + 1000 && newData.child('createdAt').val() >= now - 25000",
                "uid": {},
                "actionId": {},
                "kind": {},
                "createdAt": {},
                "payload": {
                  "name": {
                    ".validate": "newData.parent().parent().child('kind').val() === 'joinRoom' && newData.isString() && newData.val().length >= 2 && newData.val().length <= 24"
                  },
                  "type": {
                    ".validate": "newData.parent().parent().child('kind').val() === 'roomCommand' && (newData.val() === 'takeSeat' || newData.val() === 'ready' || newData.val() === 'randomSeats' || newData.val() === 'entryPolicy' || newData.val() === 'hostTransfer' || newData.val() === 'settings' || newData.val() === 'start' || newData.val() === 'pause' || newData.val() === 'resume' || newData.val() === 'rebuy' || newData.val() === 'sitOut' || newData.val() === 'timeBank' || newData.val() === 'undoPayout' || newData.val() === 'deal' || newData.val() === 'reveal' || newData.val() === 'act' || newData.val() === 'payout' || newData.val() === 'nextHand')"
                  },
                  "expectedVersion": {
                    ".validate": "newData.parent().parent().child('kind').val() === 'roomCommand' && newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 9007199254740991"
                  },
                  "seat": {
                    ".validate": "newData.parent().parent().child('kind').val() === 'roomCommand' && newData.parent().child('type').val() === 'takeSeat' && (newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 8)"
                  },
                  "stack": {
                    ".validate": "newData.parent().parent().child('kind').val() === 'roomCommand' && newData.parent().child('type').val() === 'settings' && (newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 1000000000)"
                  },
                  "sb": {
                    ".validate": "newData.parent().parent().child('kind').val() === 'roomCommand' && newData.parent().child('type').val() === 'settings' && (newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 1000000000)"
                  },
                  "bb": {
                    ".validate": "newData.parent().parent().child('kind').val() === 'roomCommand' && newData.parent().child('type').val() === 'settings' && (newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 1000000000)"
                  },
                  "ante": {
                    ".validate": "newData.parent().parent().child('kind').val() === 'roomCommand' && newData.parent().child('type').val() === 'settings' && (newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 1000000000)"
                  },
                  "anteMode": {
                    ".validate": "newData.parent().parent().child('kind').val() === 'roomCommand' && newData.parent().child('type').val() === 'settings' && (newData.val() === 'each' || newData.val() === 'bb')"
                  },
                  "buyInCents": {
                    ".validate": "newData.parent().parent().child('kind').val() === 'roomCommand' && newData.parent().child('type').val() === 'settings' && (newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 1000000000)"
                  },
                  "targetUid": {
                    ".validate": "newData.parent().parent().child('kind').val() === 'roomCommand' && (newData.parent().child('type').val() === 'rebuy' || newData.parent().child('type').val() === 'hostTransfer') && newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
                  },
                  "chips": {
                    ".validate": "newData.parent().parent().child('kind').val() === 'roomCommand' && newData.parent().child('type').val() === 'rebuy' && (newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 1000000000)"
                  },
                  "blindPlan": {
                    ".validate": "newData.parent().parent().child('kind').val() === 'roomCommand' && newData.parent().child('type').val() === 'settings' && newData.hasChildren()",
                    "$step": {
                      ".validate": "$step.matches(/^(0|[1-9]|1[0-9]|2[0-3])$/) && newData.hasChildren(['kind','minutes']) && ((newData.child('kind').val() === 'level' && newData.hasChildren(['sb','bb']) && newData.child('sb').val() < newData.child('bb').val()) || (newData.child('kind').val() === 'break' && newData.child('minutes').val() <= 60))",
                      "kind": {
                        ".validate": "newData.val() === 'level' || newData.val() === 'break'"
                      },
                      "minutes": {
                        ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 180"
                      },
                      "sb": {
                        ".validate": "newData.parent().child('kind').val() === 'level' && newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 1000000000"
                      },
                      "bb": {
                        ".validate": "newData.parent().child('kind').val() === 'level' && newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 1000000000"
                      },
                      "ante": {
                        ".validate": "newData.parent().child('kind').val() === 'level' && newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 1000000000 && newData.val() <= newData.parent().child('bb').val()"
                      },
                      "anteMode": {
                        ".validate": "newData.parent().child('kind').val() === 'level' && (newData.val() === 'each' || newData.val() === 'bb')"
                      },
                      "$other": {
                        ".validate": false
                      }
                    }
                  },
                  "denominations": {
                    ".validate": "newData.parent().parent().child('kind').val() === 'roomCommand' && newData.parent().child('type').val() === 'settings' && newData.hasChildren()",
                    "$chip": {
                      ".validate": "$chip.matches(/^[0-9]$/) && newData.hasChildren(['color','value'])",
                      "color": {
                        ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
                      },
                      "value": {
                        ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 1000000000"
                      },
                      "$other": {
                        ".validate": false
                      }
                    }
                  },
                  "joinOpen": {
                    ".validate": "newData.parent().parent().child('kind').val() === 'roomCommand' && newData.parent().child('type').val() === 'entryPolicy' && (newData.isBoolean())"
                  },
                  "lateRegistration": {
                    ".validate": "newData.parent().parent().child('kind').val() === 'roomCommand' && newData.parent().child('type').val() === 'entryPolicy' && (newData.isBoolean())"
                  },
                  "sittingOut": {
                    ".validate": "newData.parent().parent().child('kind').val() === 'roomCommand' && newData.parent().child('type').val() === 'sitOut' && (newData.isBoolean())"
                  },
                  "blindMinutes": {
                    ".validate": "newData.parent().parent().child('kind').val() === 'roomCommand' && newData.parent().child('type').val() === 'settings' && (newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 180)"
                  },
                  "blindMultiplier": {
                    ".validate": "newData.parent().parent().child('kind').val() === 'roomCommand' && newData.parent().child('type').val() === 'settings' && (newData.val() === 1.5 || newData.val() === 2)"
                  },
                  "handId": {
                    ".validate": "newData.parent().parent().child('kind').val() === 'roomCommand' && newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 9007199254740991"
                  },
                  "move": {
                    ".validate": "newData.parent().parent().child('kind').val() === 'roomCommand' && newData.parent().child('type').val() === 'act' && newData.hasChildren(['kind'])",
                    "kind": {
                      ".validate": "newData.val() === 'fold' || newData.val() === 'check' || newData.val() === 'call' || newData.val() === 'bet' || newData.val() === 'raise' || newData.val() === 'all-in'"
                    },
                    "to": {
                      ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 9007199254740991"
                    },
                    "$other": {
                      ".validate": false
                    }
                  },
                  "winners": {
                    ".validate": "newData.parent().parent().child('kind').val() === 'roomCommand' && newData.parent().child('type').val() === 'payout' && newData.hasChildren()",
                    "$pot": {
                      ".validate": "$pot.matches(/^[0-8]$/) && newData.hasChildren()",
                      "$index": {
                        ".validate": "$index.matches(/^[0-8]$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
                      }
                    }
                  },
                  "$other": {
                    ".validate": false
                  },
                  ".validate": "(newData.parent().child('kind').val() === 'joinRoom' && newData.hasChildren(['name'])) || (newData.parent().child('kind').val() === 'roomCommand' && newData.hasChildren(['type','expectedVersion']))"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          }
        },
        "responses": {
          "$roomId": {
            "$uid": {
              ".read": "auth != null && (auth.uid === $uid || root.child('poker/v2/rooms').child($roomId).child('hostUid').val() === auth.uid)",
              "$actionId": {
                ".write": "auth != null && (root.child('poker/v2/rooms').child($roomId).child('hostUid').val() === auth.uid || (auth.uid === $uid && !newData.exists()))",
                ".validate": "newData.hasChildren(['ok']) && newData.child('ok').isBoolean()",
                "ok": {},
                "version": {
                  ".validate": "newData.isNumber()"
                },
                "error": {
                  ".validate": "newData.isString() && newData.val().length <= 300"
                },
                "$other": {
                  ".validate": false
                },
                "fingerprint": {
                  ".validate": "newData.isString() && newData.val().length <= 20000"
                }
              }
            }
          }
        }
      }
    }
  }
}
